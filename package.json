{
  "name": "sainthr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter='@sainthr/*' run dev",
    "dev:site": "bun --filter=@sainthr/site run dev",
    "dev:careers": "bun --filter=@sainthr/careers run dev",
    "dev:admin": "bun --filter=@sainthr/admin run dev",
    "build": "bun run build:site && bun run build:careers && bun run build:admin",
    "build:site": "bun --filter=@sainthr/site run build",
    "build:careers": "bun --filter=@sainthr/careers run build",
    "build:admin": "bun --filter=@sainthr/admin run build",
    "start": "bun run start:site",
    "start:site": "bun --filter=@sainthr/site run start",
    "start:careers": "bun --filter=@sainthr/careers run start",
    "start:admin": "bun --filter=@sainthr/admin run start",
    "lint": "bun run lint:site && bun run lint:careers && bun run lint:admin",
    "lint:site": "bun --filter=@sainthr/site run lint",
    "lint:careers": "bun --filter=@sainthr/careers run lint",
    "lint:admin": "bun --filter=@sainthr/admin run lint",
    "typecheck": "bun run typecheck:site && bun run typecheck:careers && bun run typecheck:admin",
    "typecheck:site": "bun --filter=@sainthr/site run typecheck",
    "typecheck:careers": "bun --filter=@sainthr/careers run typecheck",
    "typecheck:admin": "bun --filter=@sainthr/admin run typecheck",
    "add:site": "bun add --filter=@sainthr/site",
    "add:site:dev": "bun add -d --filter=@sainthr/site",
    "add:careers": "bun add --filter=@sainthr/careers",
    "add:careers:dev": "bun add -d --filter=@sainthr/careers",
    "add:admin": "bun add --filter=@sainthr/admin",
    "add:admin:dev": "bun add -d --filter=@sainthr/admin"
  },
  "dependencies": {
    "@clerk/nuxt": "^2.4.6",
    "@lucide/vue": "^1.16.0",
    "@pinia/nuxt": "^0.11.3",
    "nuxt": "^4.4.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vue-tsc": "^3.1.5"
  },
  "packageManager": "bun@1.3.11"
}
