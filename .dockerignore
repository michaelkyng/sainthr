# Dependencies (reinstalled cleanly inside the image)
node_modules
**/node_modules

# Nuxt / Nitro build artifacts (rebuilt inside the image)
.nuxt
**/.nuxt
.output
**/.output
.data
**/.data

# Local env files — secrets are injected at runtime by Render, never baked in
.env
.env.*
!.env.example

# VCS & tooling
.git
.gitignore
.github
.vscode
.idea

# Logs & misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
coverage

# Docs (not needed at build time)
*.md
